            @* Donor Modal Scripts *@
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            @* Put this script right after the modal markup in Index.cshtml *@
            <script>
                (function () {
                    // ensure bootstrap is available
                    const donorModalEl = document.getElementById('donorModal');
                    let donorModal = null;
                    if (donorModalEl) donorModal = new bootstrap.Modal(donorModalEl);

                    // helper to prefill fields
                    function prefill(formData) {
                        if (!formData) return;
                        try {
                            document.getElementById('modalDonorName').value = formData.DonorName || '';
                            document.getElementById('modalGender').value = formData.Gender || '';
                            document.getElementById('modalMobile').value = formData.MobileNumber || '';
                            document.getElementById('modalEmail').value = formData.Email || '';
                            document.getElementById('modalAddress').value = formData.Address || '';
                            if (formData.HospitalId) document.getElementById('modalHospitalId').value = formData.HospitalId;
                            document.getElementById('modalServiceType').value = formData.ServiceType || 'Free';
                        } catch (ex) {
                            console.warn('Prefill error', ex);
                        }
                    }

                    // show modal and optionally show messages
                    function openAndShow(data) {
                        if (!donorModal) return;
                        if (data && data.formData) prefill(data.formData);

                        donorModal.show();

                        // show errors or success message
                        if (data) {
                            if (data.success === true) {
                                // success - show a quick toast/alert then hide modal after 1.5s
                                const alertDiv = document.createElement('div');
                                alertDiv.className = 'alert alert-success fixed-top m-3';
                                alertDiv.style.zIndex = 2000;
                                alertDiv.textContent = data.message || 'Saved successfully';
                                document.body.appendChild(alertDiv);
                                setTimeout(() => {
                                    donorModal.hide();
                                    alertDiv.remove();
                                }, 1300);
                            } else if (data.errors && data.errors.length) {
                                // show list of errors above form (create container if not exists)
                                let errorBox = document.getElementById('donorErrorBox');
                                if (!errorBox) {
                                    errorBox = document.createElement('div');
                                    errorBox.id = 'donorErrorBox';
                                    errorBox.className = 'alert alert-danger';
                                    const body = donorModalEl.querySelector('.modal-body');
                                    body.insertBefore(errorBox, body.firstChild);
                                }
                                errorBox.innerHTML = '<ul style="margin:0;padding-left:18px;"></ul>';
                                const ul = errorBox.querySelector('ul');
                                data.errors.forEach(e => {
                                    const li = document.createElement('li');
                                    // friendly field name if provided
                                    li.textContent = (e.Field ? e.Field + ': ' : '') + (e.Error || e.ErrorMessage || e.error || '');
                                    ul.appendChild(li);
                                });
                            }
                        }
                    }

                    // 1) Auto open when page loads if ?mode=donor (your server side already renders the modal block)
                    document.addEventListener('DOMContentLoaded', function () {
                        // if page was visited with mode=donor the modal block exists, show it
                        const urlParams = new URLSearchParams(window.location.search);
                        if (urlParams.get('mode') === 'donor') {
                            if (donorModal) donorModal.show();
                        }

                        // 2) If server provided donor feedback JSON (via ViewBag), pick it up and act
                        const fbJson = @Html.Raw(Json.Serialize(ViewBag.DonorFeedbackJson ?? "null"));
                        try {
                            const fb = fbJson && fbJson !== 'null' ? JSON.parse(fbJson) : null;
                            if (fb) {
                                openAndShow(fb);
                            }
                        } catch (err) {
                            console.warn('Invalid donor feedback JSON', err);
                        }
                    });

                    // expose helper so your example buttons still work
                    window.openDonorModal = function (opts) {
                        if (!donorModal) donorModal = new bootstrap.Modal(donorModalEl);
                        if (opts && opts.fullname) document.getElementById('modalDonorName').value = opts.fullname;
                        if (opts && opts.mobile) document.getElementById('modalMobile').value = opts.mobile;
                        if (opts && opts.email) document.getElementById('modalEmail').value = opts.email;
                        if (opts && opts.address) document.getElementById('modalAddress').value = opts.address;
                        if (opts && opts.hospitalId) document.getElementById('modalHospitalId').value = opts.hospitalId;
                        if (opts && opts.serviceType) document.getElementById('modalServiceType').value = opts.serviceType;
                        if (opts && opts.gender) document.getElementById('modalGender').value = opts.gender;
                        donorModal.show();
                    };
                })();
            </script>


            <!-- Example Buttons -->
            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    onclick="openDonorModal({ hospitalId: 1, serviceType: 'Free' })">
                Register Donor (Free)
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-warning"
                    onclick="openDonorModal({ hospitalId: 1, serviceType: 'Paid' })">
                Register Donor (Paid)
            </button>
        }



















