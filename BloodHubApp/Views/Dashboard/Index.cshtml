                    <button type="button" class="btn btn-outline-danger btn-sm" id="btnDownloadRequestPdf">
                        Download PDF
                    </button>
                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "Dashboard", new { mode = "requests" })">
                        Add another
                    </a>
                </div>
            </div>

            <script>
                // Pass the saved record to JS
                window.__lastRequest = @Html.Raw(TempData["LastRequestJson"]);
            </script>

            <!-- jsPDF (no integrity attribute to avoid blocking) -->
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"
                    crossorigin="anonymous" referrerpolicy="no-referrer"></script>

            <script>
                (function () {
                    const saved = window.__lastRequest;
                    const btn = document.getElementById('btnDownloadRequestPdf');
                    if (!btn || !saved) return;

                    btn.addEventListener('click', function () {
                        try {
                            const data = typeof saved === 'string' ? JSON.parse(saved) : saved;
                            makeRequestPdf(data);
                        } catch (e) {
                            alert('Could not prepare PDF: ' + (e && e.message ? e.message : e));
                        }
                    });

                    function makeRequestPdf(r) {
                        const { jsPDF } = window.jspdf;
                        const pdf = new jsPDF('p', 'pt', 'a4');
                        const pageW = pdf.internal.pageSize.getWidth();

                        pdf.setFontSize(18);
                        pdf.text('Blood Request', 40, 50);

                        pdf.setFontSize(10);
                        pdf.setTextColor(120);
                        const dt = r.requestedAt ? toLocal(r.requestedAt) : new Date().toLocaleString();
                        pdf.text(`Request ID: ${r.id ?? '-'}`, 40, 68);
                        pdf.text(`Created: ${dt}`, 40, 82);

                        pdf.setDrawColor(200); pdf.line(40, 92, pageW - 40, 92);
                        pdf.setTextColor(0); pdf.setFontSize(12);

                        let y = 120;
                        y = row(pdf, y, 'Hospital', r.hospitalName ?? r.hospitalId ?? '-');
                        y = row(pdf, y, 'Blood Group', r.bloodGroup ?? '-');
                        y = row(pdf, y, 'Units', String(r.units ?? '-'));
                        y = row(pdf, y, 'Person Name', r.personName ?? '-');
                        y = row(pdf, y, 'Mobile Number', r.mobileNumber ?? '-');
                        y = row(pdf, y, 'Address', r.address ?? '-');

                        pdf.setDrawColor(200); pdf.line(40, y + 10, pageW - 40, y + 10);
                        pdf.setFontSize(9);
                        pdf.text('Generated by BloodHub', 40, y + 28);

                        const fname = `BloodRequest_${r.id ?? 'new'}_${(new Date()).toISOString().slice(0,10)}.pdf`;
                        pdf.save(fname);
                    }

                    function row(pdf, y, label, value) {
                        pdf.setFont(undefined, 'bold'); pdf.text(label + ':', 40, y);
                        pdf.setFont(undefined, 'normal');
                        pdf.text(String(value), 160, y, {
                            maxWidth: pdf.internal.pageSize.getWidth() - 200
                        });
                        return y + 24;
                    }

                    function toLocal(x) {
                        try {
                            const d = new Date(x);
                            return isNaN(d.getTime()) ? String(x) : d.toLocaleString();
                        } catch { return String(x); }
                    }
                })();
            </script>
        }

