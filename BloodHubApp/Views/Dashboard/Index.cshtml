                                                    <td class="text-center">@h.Stock!.OPos</td>
                                                    <td class="text-center">@h.Stock!.ONeg</td>
                                                    <td class="text-center">@h.Stock!.ABPos</td>
                                                    <td class="text-center">@h.Stock!.ABNeg</td>
                                                    <td class="text-center fw-bold">@h.Stock!.Total</td>
                                                    <td class="text-center">@h.Stock!.UpdatedAt.ToString("dd-MM-yyyy HH:mm:ss")</td> <!-- 🆕 -->
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>




                            <!-- 🏥 Blood Bank Inventory Table -->
                            <div class="table-responsive">
                            </div>

                            <!-- 🧠 Hover Logic Script -->
                            <script>
                                document.addEventListener('DOMContentLoaded', function () {
                                    const barCanvas = document.getElementById('barChart');
                                    const getMainChart = () => barCanvas ? Chart.getChart(barCanvas) : null;

                                    // Column indices based on table structure
                                    const COL = { Apos:2, Aneg:3, Bpos:4, Bneg:5, Opos:6, Oneg:7, ABpos:8, ABneg:9 };

                                    function getNum(td) {
                                        const txt = (td?.textContent || '').trim().replace(/[^\d-]/g, '');
                                        const n = parseInt(txt, 10);
                                        return isNaN(n) ? 0 : n;
                                    }

                                    function valuesFromRow(tr) {
                                        const c = tr.cells;
                                        return [
                                            getNum(c[COL.Apos]), getNum(c[COL.Aneg]),
                                            getNum(c[COL.Bpos]), getNum(c[COL.Bneg]),
                                            getNum(c[COL.Opos]), getNum(c[COL.Oneg]),
                                            getNum(c[COL.ABpos]), getNum(c[COL.ABneg])
                                        ];
                                    }

                                    function hospitalNameFromRow(tr) {
                                        const strong = tr.querySelector('td:first-child .fw-bold');
                                        return (strong?.textContent || tr.cells[0]?.textContent || '').trim();
                                    }

                                    const rows = document.querySelectorAll('#inventoryTable tbody tr');
                                    let originalTotals = null;

                                    rows.forEach(tr => {
                                        tr.addEventListener('mouseenter', () => {
                                            const chart = getMainChart();
                                            if (!chart) return;
                                            if (!originalTotals) originalTotals = [...chart.data.datasets[0].data];

                                            const vals = valuesFromRow(tr);
                                            const name = hospitalNameFromRow(tr);

                                            chart.data.datasets[0].data = vals;
                                            chart.options.plugins.title = { display: true, text: 'Stock by Blood Group - ' + name };
                                            chart.update();
                                        });

                                        tr.addEventListener('mouseleave', () => {
                                            const chart = getMainChart();
                                            if (chart && originalTotals) {
                                                chart.data.datasets[0].data = originalTotals;
                                                chart.options.plugins.title = { display: true, text: 'Stock by Blood Group - Total' };
                                                chart.update();
                                            }
                                        });
                                    });
                                });
                            </script>





                            <style>
                                /* 💜 Top caption bar like Easy DataTable */
                                .table-caption {
                                    caption-side: top;
                                    background: #e6d7ff; /* light lavender */
                                    color: #1f1f1f;
                                    font-weight: 600;
                                    padding: 10px 16px;
                                    margin: 0;
                                    text-align: left;
                                    border-radius: 10px 10px 0 0;
                                }

                                /* 🟣 Header styling */
                                #inventoryTable thead.custom-header th {
                                    background-color: #6a1b9a !important; /* deep purple */
                                    color: #ffffff !important;
                                    font-weight: 600;
                                    text-align: center;
                                    vertical-align: middle;
                                    border: none;
                                    padding: 10px;
                                }

                                /* Ensure th inherits our bg (override Bootstrap) */
                                #inventoryTable > :not(caption) > * > * {
                                    background-color: inherit;
                                }

                                /* Rounded header corners */
                                #inventoryTable thead.custom-header th:first-child {
                                    border-top-left-radius: 10px;
                                }

                                #inventoryTable thead.custom-header th:last-child {
                                    border-top-right-radius: 10px;
                                }

                                /* Zebra striping */
                                #inventoryTable tbody tr:nth-child(odd) {
                                    background-color: #f9f9f9;
                                }

                                #inventoryTable tbody tr:nth-child(even) {
                                    background-color: #ffffff;
                                }

                                #inventoryTable tbody tr:hover {
                                    background-color: #f1f1f1;
                                }

                                /* Sticky header when scrolling */
                                #inventoryTable thead.custom-header th {
                                    position: sticky;
                                    top: 0;
                                    z-index: 2;
                                }
                            </style>

                        </div>

                    </div>
                }
        </div>
    </div>

@if (fullMode && !requestsMode && !ordersMode && !tableOnly)
{
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>
        <script>
            const C = getComputedStyle(document.documentElement);
            const colors = [
                C.getPropertyValue('--Apos').trim(), C.getPropertyValue('--Aneg').trim(),
                C.getPropertyValue('--Bpos').trim(), C.getPropertyValue('--Bneg').trim(),
                C.getPropertyValue('--Opos').trim(), C.getPropertyValue('--Oneg').trim(),
                C.getPropertyValue('--ABpos').trim(), C.getPropertyValue('--ABneg').trim()
            ];
            new Chart(document.getElementById('lineChart'), {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Days)),
                    datasets: [{
                        label: 'Donations',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DonationsPerDay)),
                        borderColor: '#4e54c8', backgroundColor: 'rgba(78,84,200,.15)', fill: true, tension: .35, pointRadius: 3
                    }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });
            new Chart(document.getElementById('barChart'), {
                type: 'bar',
                data: {
                    labels: ['A+','A-','B+','B-','O+','O-','AB+','AB-'],
                    datasets: [{
                        data: [@Model.APos,@Model.ANeg,@Model.BPos,@Model.BNeg,@Model.OPos,@Model.ONeg,@Model.ABPos,@Model.ABNeg],
                        backgroundColor: colors, borderRadius: 8
                    }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });
        </script>
}
