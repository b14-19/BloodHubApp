        @using Microsoft.AspNetCore.Http
        @{
            var role = Context.Session.GetString("Role") ?? "User";
            bool isUser = role.Equals("User", StringComparison.OrdinalIgnoreCase);
            bool isAdmin = role.Equals("Admin", StringComparison.OrdinalIgnoreCase);
            bool isSuper = role.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase);
        }

        <ul class="nav flex-column gap-1">
            <!-- Always visible -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "full" })">🏠 Dashboard</a>
            </li>

            @if (isUser)
            {
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "table" })">📑 Reports</a></li>
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "requests" })">📦 Hospital Request to Blood Bank</a></li>
            }

            @if (isAdmin)
            {
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "users" })">👤 New User Create</a></li>
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "hospitals" })">🏥 Blood Bank</a></li>
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "table" })">📑 Reports</a></li>
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "requests" })">📦 Hospital Request to Blood Bank</a></li>
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "alerts" })">📰 Alerts</a></li>
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "donor" })">🧑‍🤝‍🧑 BloodDonor Free / Paid Service</a></li>
            }

            @if (isSuper)
            {
                <!-- show everything -->
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "users" })">👤 New User Create</a></li>
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "hospitals" })">🏥 Blood Bank</a></li>
                <li><a class="nav-link" href="#">💉 Inventory</a></li>
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "table" })">📑 Reports</a></li>
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "requests" })">📦 Hospital Request to Blood Bank</a></li>
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "orders" })">🩸 BloodOrders</a></li>
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "alerts" })">📰 Alerts</a></li>
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "donor" })">🧑‍🤝‍🧑 BloodDonor Free / Paid Service</a></li>
                <li><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { mode = "donordata" })">👥 DonorDatas</a></li>
            }
        </ul>


    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 p-4">
        <!-- User Info Bar -->
        <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded shadow-sm"
             style="background:#121826; color:#fff; border-radius:12px;">

            <div class="d-flex flex-column">
                <div class="d-flex align-items-center mb-1">
                    <i class="bi bi-person-circle me-2 fs-5 text-info"></i>
                    <span class="fw-bold">User Name:</span> @Context.Session.GetString("Username")
                </div>
                <div class="d-flex align-items-center">
                    <i class="bi bi-clock-history me-2 fs-5 text-warning"></i>
                    <span class="fw-bold">Logged In Time:</span> @Context.Session.GetString("LoginTime")
                </div>
            </div>

            <div>
                <!-- Home Button -->
                <a href="@Url.Action("Index", "Dashboard", new { mode = "full" })"
                   class="btn btn-sm btn-primary me-2 d-flex align-items-center gap-1">
                    <i class="bi bi-house-door"></i> Home
                </a>
                <!-- Logout Button -->
                <a href="@Url.Action("Logout", "Account")"
                   class="btn btn-sm btn-danger d-flex align-items-center gap-1">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>
        </div>
        @*  @if (!string.IsNullOrEmpty(Model.NotificationText))
        {
            <div class="scrolling-text mb-3">
                <span>@Model.NotificationText</span>
            </div>
        } *@











        @if (!string.IsNullOrEmpty(Model.NotificationText))
        {
            <div class="mh-marquee" role="status" aria-live="polite" title="@Model.NotificationText">
                <div class="mh-marquee__inner">
                    <span>@Model.NotificationText</span>
                </div>
            </div>
        }



        @if (ViewBag.GlobalSuccess != null)
        {
            <div class="alert alert-success">@ViewBag.GlobalSuccess</div>
        }
        @if (ViewBag.GlobalError != null)
        {
            <div class="alert alert-danger">@ViewBag.GlobalError</div>
        }





        @if (string.Equals(mode, "donordata", StringComparison.OrdinalIgnoreCase) && !requestsMode && !ordersMode && !tableOnly)
        {
            <div class="card card-grad p-3 mb-4">
                <h4 class="fw-bold mb-3">Search Donors by Hospital</h4>
                <form method="get" asp-controller="Dashboard" asp-action="Index">
                    <input type="hidden" name="mode" value="donordata" />
                    <div class="input-group mb-3">
                        <input type="number" name="hospitalId" class="form-control" placeholder="Enter Hospital ID" required />
                        <button type="submit" class="btn btn-primary">Search</button>
                    </div>
                </form>
            </div>

            @if (Model.Donors != null && Model.Donors.Any())
            {
                <div class="card card-grad p-3">
                    <h4 class="fw-bold mb-3">Donors</h4>
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Donor Name</th>
                                <th>Mobile</th>
                                <th>Email</th>
                                <th>Gender</th>
                                <th>Address</th>
                                <th>Hospital ID</th>
                                <th>Service Type</th>
                                <th>Created At</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Donors.Select((donor, index) => new { donor, index }))
                            {
                                <tr>
                                    <td>@(d.index + 1)</td>
                                    <td>@d.donor.DonorName</td>
                                    <td>@d.donor.MobileNumber</td>
                                    <td>@d.donor.Email</td>
                                    <td>@d.donor.Gender</td>
                                    <td>@d.donor.Address</td>
                                    <td>@d.donor.HospitalId</td>
                                    <td>
                                        @if (d.donor.ServiceType?.ToLower() == "paid")
                                        {
                                            <span class="badge bg-danger">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Free</span>
                                        }
                                    </td>
                                    <td>@d.donor.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (Model.Donors != null) // searched but no results
            {
                <div class="alert alert-warning" role="alert">
                    ⚠️ No donors found for this hospital.
                </div>
            }
        }


































        @if (string.Equals(mode, "users", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(mode, "donor", StringComparison.OrdinalIgnoreCase)
                && !requestsMode && !ordersMode && !tableOnly)
        {
            <div class="card card-grad p-3 mb-4">
                <h4 class="fw-bold mb-3">Create / Manage Users</h4>

                <!-- Create User Form -->
                <form asp-action="SaveUser" asp-controller="Dashboard" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row mb-2">
                        <div class="col-md-3">
                            <input type="text" name="Username" class="form-control" placeholder="Username" required />
                        </div>
                        <div class="col-md-3">
                            <input type="password" name="PasswordHash" class="form-control" placeholder="Password" required />
                        </div>
                        <div class="col-md-3">
                            <select name="Role" class="form-select" required>
                                <option>User</option>
                                <option>Admin</option>
                                <option>SuperAdmin</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input type="email" name="Email" class="form-control" placeholder="Email" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Create User</button>
                </form>
            </div>

            <!-- User List -->
            <div class="card card-grad p-3">
                <h4 class="fw-bold mb-3">User List</h4>
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Email</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users != null && Model.Users.Any())
                        {
                            var idx = 1;
                            foreach (var u in Model.Users)
                            {
                                <tr>
                                    <td>@idx</td>
                                    <td>@u.Username</td>
                                    <td>@u.Role</td>
                                    <td>@u.Email</td>
                                    <td>
                                        <!-- Edit button (open modal) -->
                                        <button type="button" class="btn btn-sm btn-primary"
                                                onclick="openEditUserModal(@u.UserId)">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        <!-- Delete POST form -->
                                        <form asp-action="DeleteUser" asp-controller="Dashboard" method="post"
                                              style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.UserId" />
                                            <button type="submit" class="btn btn-sm btn-danger ms-1"
                                                    onclick="return confirm('Delete user @u.Username ?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                idx++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted">No users found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Edit User Modal -->
            <div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="UpdateUser" asp-controller="Dashboard" method="post">
                            @Html.AntiForgeryToken()
                            <div class="modal-header">
                                <h5 class="modal-title">Edit User</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" id="editUserId" name="UserId" />
                                <div class="mb-3">
                                    <label>Username</label>
                                    <input type="text" id="editUsername" name="Username" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label>Password (leave blank to keep current)</label>
                                    <input type="password" id="editPassword" name="PasswordHash" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label>Role</label>
                                    <select id="editRole" name="Role" class="form-select">
                                        <option>User</option>
                                        <option>Admin</option>
                                        <option>Nurse</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label>Email</label>
                                    <input type="email" id="editEmail" name="Email" class="form-control" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary">Save</button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <script>
                function openEditUserModal(userId) {
                    fetch('@Url.Action("GetUserJson", "Dashboard")?id=' + userId)
                        .then(res => res.json())
                        .then(u => {
                            document.getElementById('editUserId').value = u.userId;
                            document.getElementById('editUsername').value = u.username;
                            document.getElementById('editRole').value = u.role;
                            document.getElementById('editEmail').value = u.email;
                            document.getElementById('editPassword').value = '';
                            new bootstrap.Modal(document.getElementById('editUserModal')).show();
                        })
                        .catch(err => alert("Error loading user: " + err));
                }
            </script>
        }










        @* ==== Donor Modal ==== *@
        @if (string.Equals(mode, "donor", StringComparison.OrdinalIgnoreCase) && !requestsMode && !ordersMode && !tableOnly)
        {
            <div class="modal fade" id="donorModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form id="donorModalForm" asp-action="DonorService" asp-controller="Dashboard" method="post">
                            @Html.AntiForgeryToken()
                            <div class="modal-header">
                                <h5 class="modal-title">Register as Blood Donor</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">Donor Name</label>
