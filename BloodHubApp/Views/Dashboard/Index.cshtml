                        // ---------- PDF ----------
                        window.exportTableToPdf = function () {
                          const table = document.getElementById('inventoryTable');
                          if (!table) { alert('inventoryTable not found'); return; }

                          const jsPDF = window.jspdf && (window.jspdf.jsPDF || window.jspdf);
                          if (!jsPDF) { alert('jsPDF not loaded'); return; }
                          if (!jsPDF.API?.autoTable && !window.jspdf.jsPDF.API?.autoTable) {
                            alert('jsPDF autoTable plugin not loaded'); return;
                          }

                          // headers
                          const head = [Array.from(table.querySelectorAll('thead th')).map(th => th.textContent.trim())];
                          // body
                          const body = Array.from(table.querySelectorAll('tbody tr'))
                            .map(tr => Array.from(tr.cells).map(td => (td.textContent || '').trim()));

